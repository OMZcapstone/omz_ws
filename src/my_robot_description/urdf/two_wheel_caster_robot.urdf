<?xml version="1.0"?>
<robot name="two_wheel_caster_robot">

  <!--
    Coordinate convention:
      x+: front of robot
      y+: left side of robot
      z+: up

    This model uses base_link at the center of the robot body.
    Edit the dimensions and joint origins below to match your real robot.
  -->

  <material name="body_blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="wheel_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <material name="caster_gray">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>

  <!-- Ground-plane footprint: the point on the floor directly below the robot center.
       Navigation stacks (nav2, AMCL) publish poses for this frame at z=0. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- wheel_center_depth(0.195) + wheel_radius(0.065) = 0.26 m above ground -->
    <origin xyz="0 0 0.26" rpy="0 0 0"/>
  </joint>

  <!-- Body: change box size to your chassis length, width, and height. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.50 0.26"/>
      </geometry>
      <material name="body_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.50 0.26"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia
        ixx="0.20" ixy="0.0" ixz="0.0"
        iyy="0.40" iyz="0.0"
        izz="0.50"/>
    </inertial>
  </link>

  <!-- Front left encoder in-wheel motor. -->
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.064"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.064"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia
        ixx="0.005" ixy="0.0" ixz="0.0"
        iyy="0.005" iyz="0.0"
        izz="0.003"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <!-- x: front, y: left, z: wheel center height relative to base_link. -->
    <origin xyz="0.165 0.144 -0.195" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front right encoder in-wheel motor. -->
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.064"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.064"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia
        ixx="0.005" ixy="0.0" ixz="0.0"
        iyy="0.005" iyz="0.0"
        izz="0.003"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <!-- x: front, y: right, z: wheel center height relative to base_link. -->
    <origin xyz="0.165 -0.144 -0.195" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear caster wheel: simplified as one free rolling wheel. -->
  <link name="rear_caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
      <material name="caster_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="rear_caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_wheel"/>
    <origin xyz="-0.165 0.0 -0.21" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- RPLIDAR C1 mounted at the vehicle centerline.
       The sensor body faces forward, but its LaserScan 0-degree direction is
       reported 180 degrees from the robot front, so rotate the laser frame. -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.0 0.0 0.47" rpy="0 0 3.14159265359"/>
  </joint>

  <!-- WIT IMU mounted behind the vehicle centerline. -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.01"/>
      </geometry>
      <material name="caster_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.07 0.19 0.14" rpy="0 0 0"/>
  </joint>

</robot>
